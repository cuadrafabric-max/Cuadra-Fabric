<section id="pricing" class="alt">
  <div class="wrap">
    <div class="sec-h">
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.text | escape }}</p>
    </div>

    <div class="card audit-offer">
      <div>
        <span class="st st-live">Available today</span>
        <h3>Store Audit</h3>
        <p>48-Hour E-Commerce Revenue &amp; Automation Audit: Health Score, 3 things to fix today, and a ranked plan across 13 areas, delivered within 48 hours of payment.</p>
      </div>
      <div class="buy">
        <div class="price">$297<small> one-time</small></div>
        <a class="btn btn-p btn-lg" href="https://cuadra-audit-flow.base44.app">Start my audit</a>
      </div>
    </div>

    <h3 class="plans-h">Platform plans <span class="st st-soon">Early access &middot; not yet available</span></h3>
    <p class="plans-note">These plans launch with the platform. Features listed are what each plan will include at launch.</p>
    <div class="toggle" role="group" aria-label="Billing period">
      <button id="mo" aria-pressed="true">Monthly</button><button id="yr" aria-pressed="false">Annual &middot; save 20%</button>
    </div>
    <div class="plans">
      <div class="card plan"><h3>Foundation</h3>
        <p class="desc">For smaller operators who need store intelligence and auditing.</p>
        <div class="price"><span data-m="79" data-y="63">$79</span><small> /month</small></div><div class="billed" data-b="79"></div>
        <ul><li>Store Auditor with recommendations</li><li>Health score and core dashboard</li><li>1 store, 1 data source</li><li>Weekly email digest</li></ul>
        <a class="btn btn-g" href="mailto:cuadrafabric@gmail.com?subject=Early%20access%20%E2%80%94%20Foundation">Join early access</a></div>
      <div class="card plan pop"><h3>Growth <span class="badge">Most popular</span></h3>
        <p class="desc">For growing businesses that need deeper analytics, monitoring, and automation.</p>
        <div class="price"><span data-m="149" data-y="119">$149</span><small> /month</small></div><div class="billed" data-b="149"></div>
        <ul><li>Everything in Foundation</li><li>Profitability and ad performance</li><li>Inventory and fulfillment monitoring</li><li>Automated alerts</li><li>Up to 3 data sources</li></ul>
        <a class="btn btn-p" href="mailto:cuadrafabric@gmail.com?subject=Early%20access%20%E2%80%94%20Growth">Join early access</a></div>
      <div class="card plan"><h3>Scale</h3>
        <p class="desc">For serious operators who need advanced intelligence and more sophisticated automation.</p>
        <div class="price"><span data-m="299" data-y="239">$299</span><small> /month</small></div><div class="billed" data-b="299"></div>
        <ul><li>Everything in Growth</li><li>Multiple stores and data sources</li><li>Advanced monitoring and workflows</li><li>Priority support</li></ul>
        <a class="btn btn-g" href="mailto:cuadrafabric@gmail.com?subject=Early%20access%20%E2%80%94%20Scale">Join early access</a></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cuadra · Pricing",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pricing built around what you learn, not what you install." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Start with the Store Audit today. Platform plans open to early-access operators first." }
  ],
  "presets": [
    {
      "name": "Cuadra · Pricing"
    }
  ]
}
{% endschema %}
