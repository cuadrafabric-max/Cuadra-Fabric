<header class="hero" id="top">
  <div class="wrap hero-grid">
    <div>
      <h1>Know what your business actually makes.</h1>
      <p class="lede">Cuadra Fabric connects your store, advertising, inventory, fulfillment, and financial data into one operating view, then tells you what needs attention.</p>
      <div class="cta-row">
        <a class="btn btn-p btn-lg" href="#auditor">Audit my store</a>
        <a class="btn btn-g btn-lg" href="#platform">Explore Cuadra Fabric</a>
      </div>
      <div class="trust"><span>$297 one-time Store Audit</span><span>Report within 48 hours</span><span>Read-only &mdash; we never change your store</span></div>
    </div>

    <aside class="card audit" aria-label="Sample audit result">
      <div class="audit-h"><span>Store health &middot; sample-store.myshopify.com</span><span class="chip">SAMPLE DATA</span></div>
      <div class="score-row">
        <div class="dial">
          <svg width="132" height="132" viewBox="0 0 132 132" aria-hidden="true">
            <circle cx="66" cy="66" r="56" fill="none" stroke="#1B2A4D" stroke-width="10"/>
            <circle class="arc" cx="66" cy="66" r="56" fill="none" stroke="#0A66FF" stroke-width="10" stroke-linecap="round"/>
          </svg>
          <b>72<small>HEALTH SCORE</small></b>
        </div>
        <div class="tally">
          <div><span><i class="dot d-r"></i>Critical</span><b>3</b></div>
          <div><span><i class="dot d-a"></i>Needs attention</span><b>8</b></div>
          <div><span><i class="dot d-g"></i>Healthy</span><b>21</b></div>
        </div>
      </div>
      <p class="fix-t">3 things you should fix today</p>
      <div class="fix"><i class="dot d-r"></i><div>Checkout drops 41% of mobile sessions<em>Payment step loads in 6.2s on mobile</em></div></div>
      <div class="fix"><i class="dot d-r"></i><div>14 products sell below target margin<em>Fulfillment cost isn't reflected in list price</em></div></div>
      <div class="fix"><i class="dot d-a"></i><div>9 products missing meta descriptions<em>Weakens search visibility on top-selling pages</em></div></div>
    </aside>
  </div>
</header>

{% schema %}
{
  "name": "Cuadra · Hero",
  "presets": [
    {
      "name": "Cuadra · Hero"
    }
  ]
}
{% endschema %}
